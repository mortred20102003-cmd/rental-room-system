# PostgreSQL
POSTGRESQL_URL=postgresql://admin:securepassword@localhost:5432/rental_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=rental_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB
MONGODB_URL=mongodb://admin:securepassword@localhost:27017/
MONGODB_DB_NAME=rental_mongo

# Security
SECRET_KEY=change-me-to-a-very-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Owner / Admin
OWNER_EMAIL=owner@example.com
OWNER_USERNAME=owner
OWNER_PASSWORD=Owner@123

# App
APP_NAME=Rental Room Management System
API_V1_PREFIX=/api/v1
DEBUG=True
ENVIRONMENT=DEVELOPMENT
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]